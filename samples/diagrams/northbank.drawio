        <mxCell id="queue" value="Settlement Queue (Service Bus)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="zone-private"><mxGeometry x="258" y="326" width="170" height="70" as="geometry" /></mxCell>
