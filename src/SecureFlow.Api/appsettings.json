{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5180",
  "Ai": {
    "Provider": "anthropic",
    "AnthropicModel": "claude-opus-5",
    "OpenAiModel": "gpt-5.6",
    "MaxOutputTokens": 32000,
    "CacheDir": "data/cache",
    "CacheEnabled": true,
    "OfflineOnly": false
  },
  "Storage": {
    "DataDir": "data"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
