{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5180",
  "Ai": {
    "Provider": "anthropic",
    "AnthropicModel": "claude-opus-5",
    "OpenAiModel": "gpt-5.6",
    "MaxOutputTokens": 32000,
    "CacheDir": "data/cache",
    "CacheEnabled": true,
    "OfflineOnly": false
  },
  "Storage": {
    "DataDir": "data"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "SecureFlow": {
    "PublicBaseUrl": null,
    "ReportPathTemplate": "/p/{id}",
    "Auth": {
      "Enabled": false,
      "Tokens": [],
      "ProtectReads": false,
      "HeaderName": "Authorization",
      "Scheme": "Bearer"
    },
    "Retention": {
      "Enabled": false,
      "Days": 30,
      "SweepIntervalMinutes": 60,
      "InitialDelaySeconds": 30
    },
    "Upload": {
      "MaxDigestBytes": 10485760
    },
    "Scan": {
      "AutoDependencyScan": true,
      "ReuseProjectByKey": true,
      "RedactServerSideScans": false,
      "AutoCreateGroups": true,
      "AllowWithoutAi": true
    }
  },
  "Ingest": {
    "WorkDir": null,
    "BudgetChars": 480000,
    "PerFileCapChars": 24000,
    "MaxFiles": 140,
    "MaxWiringFiles": 40,
    "MaxSourceFileBytes": 200000,
    "MaxManifestBytes": 20000000,
    "MaxTreeLines": 350,
    "SkipDirs": null,
    "BinaryExtensions": null,
    "ExtraSkipDirs": [],
    "ExtraPriorityPatterns": [],
    "ExtraWiringSignals": [],
    "ResolveDependencies": true,
    "Redaction": {
      "Enabled": true,
      "Placeholder": "***REDACTED***"
    }
  },
  "DependencyScan": {
    "Enabled": true,
    "OsvBaseUrl": "https://api.osv.dev/",
    "MaxPackages": 1000,
    "BatchSize": 500,
    "Ecosystems": [],
    "TimeoutSeconds": 60,
    "UnratedSeverity": "Medium"
  }
}
