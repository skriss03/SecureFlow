        <mxCell id="vault" value="Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="zone-private"><mxGeometry x="488" y="46" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="monitor" value="Monitoring (App Insights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="zone-private"><mxGeometry x="488" y="326" width="170" height="70" as="geometry" /></mxCell>
