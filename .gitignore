# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/

# Node
node_modules/
web/dist/
web/.vite/

# Runtime data (replay cache is intentionally committed under samples/, not here)
**/data/projects/
**/data/tmp/
**/data/cache/
